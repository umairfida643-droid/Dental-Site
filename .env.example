# Django Settings
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,dentalsite-jade.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://dentalsite-jade.vercel.app

# Gmail SMTP
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Dental Bites <your-email@gmail.com>
CLINIC_ADMIN_EMAIL=your-email@gmail.com

# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=PASTE_YOUR_REAL_META_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_YOUR_REAL_PHONE_NUMBER_ID_HERE
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_CONFIRM_TEMPLATE=dental_appointment_confirmed
WHATSAPP_CANCEL_TEMPLATE=dental_appointment_cancelled
